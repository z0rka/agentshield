# Copy to .env for local development. Never commit .env.

# --- Control plane -------------------------------------------------------
POSTGRES_URL=jdbc:postgresql://localhost:5432/agentshield
POSTGRES_USER=agentshield
POSTGRES_PASSWORD=agentshield
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Shared only by the Java control plane and Python engine. Use a random value outside local dev.
AGENTSHIELD_INTERNAL_TOKEN=local-engine-token

# 32-byte base64 key used to encrypt target credentials at rest (AES-GCM).
# Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
AGENTSHIELD_CREDENTIAL_KEY=CHANGE_ME_BASE64_32_BYTES

# --- Security engine -----------------------------------------------------
AGENTSHIELD_CONTROL_PLANE_URL=http://localhost:8080
AGENTSHIELD_ENGINE_PORT=8081
AGENTSHIELD_MAX_CONCURRENT_RUNS=10
# Refuse targets on loopback and private ranges. Off for local use - the demo target is on
# loopback - and on for any deployment that accepts target URLs from users. Cloud metadata
# endpoints are refused either way, in both the engine and the control plane.
AGENTSHIELD_BLOCK_PRIVATE_TARGETS=0

# --- Optional: LLM evaluators (subjective checks only) -------------------
# Deterministic evaluators run without any of these. Critical findings never
# depend on an LLM judge.
ANTHROPIC_API_KEY=sk-ant-api03-CHANGE_ME
AGENTSHIELD_JUDGE_MODEL=claude-sonnet-5

# --- Observability -------------------------------------------------------
# Uncomment only with a collector running - `docker compose -f infra/docker-compose.yml up -d`.
# Set without one, every CLI run retries the export and buries its own output.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=agentshield-security-engine
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-CHANGE_ME
LANGFUSE_SECRET_KEY=sk-lf-CHANGE_ME
